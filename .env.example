# Copie para .env.local e preencha. NUNCA versione o .env.local.
# Local: os valores do Supabase saem de `npx supabase status`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Chave pública (anon). Pode ir para o navegador; o RLS protege os dados.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service_role: IGNORA o RLS. Só no servidor, nunca com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Chave mestra para criptografar chaves de API e CPFs: openssl rand -base64 32
# Se trocar, os dados já criptografados deixam de abrir.
ENCRYPTION_KEY=
APP_URL=http://localhost:3000
# development | test | staging | production  (o seed se recusa a rodar em production)
APP_ENV=development
# Nome provisório exibido no app
NEXT_PUBLIC_PRODUCT_NAME=[NOME_DO_PRODUTO]
# Usado só pelos testes de banco (RLS)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
